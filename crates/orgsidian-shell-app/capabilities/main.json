{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window — all v0.1 plugin defaults",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:default",
    "dialog:default",
    "fs:default",
    "global-shortcut:default",
    "log:default",
    "os:default",
    "process:default",
    "shell:default",
    "store:default",
    "window-state:default",
    "updater:default"
  ]
}
