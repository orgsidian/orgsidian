{
  "name": "shell-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsr generate && lingui compile && cargo test --locked --package orgsidian-shell-app --test export_bindings --quiet",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "extract": "lingui extract --clean",
    "compile": "lingui compile",
    "i18n:check": "lingui extract --clean && git diff --exit-code src/locales",
    "test:contrast": "vitest run src/themes/contrast.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "e2e:setup": "playwright install chromium",
    "a11y": "pnpm run test:contrast && pnpm run test:e2e:a11y"
  },
  "dependencies": {
    "@lingui/core": "^6.0.1",
    "@lingui/react": "^6.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-global-shortcut": "~2.3.1",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@tauri-apps/plugin-store": "~2.4.3",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "@tauri-apps/plugin-window-state": "~2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lingui/cli": "^6.0.1",
    "@lingui/conf": "^6.0.1",
    "@lingui/swc-plugin": "^6.0.1",
    "@lingui/vite-plugin": "^6.0.1",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "^1.167.8",
    "@tanstack/router-plugin": "^1.168.6",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint-plugin-lingui": "^0.13.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  }
}
