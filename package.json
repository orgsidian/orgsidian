{
  "name": "orgsidian",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform desktop org-mode app — pnpm + Cargo monorepo root",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "dev": "pnpm --filter shell-ui dev",
    "build": "pnpm --filter shell-ui build",
    "tauri": "tauri",
    "audit:js": "pnpm audit --audit-level=moderate --prod",
    "audit:licenses:js": "pnpm licenses ls --prod --long --json | node scripts/check-pnpm-licenses.mjs",
    "supply-chain": "pnpm run audit:js && pnpm run audit:licenses:js"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@tauri-apps/cli": "^2",
    "husky": "9.1.7"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  }
}
